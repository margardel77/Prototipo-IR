<%- include('../partials/top', { variant: 'socio' }) %>
<div class="container page cuota-page">
  <div class="page-head">
    <h1>Mi cuota</h1>
    <p class="sub">Consulta tus cuotas por ejercicio.</p>
  </div>
  <%- include('../partials/flash') %>
  <% if (!cuota) { %>
    <div class="empty">Todavía no tienes ninguna cuota registrada.</div>
  <% } else { const pagada = cuota.estado === 'PAGADA'; %>
    <div class="grid grid-cuota stretch">
      <section class="card cuota-card">
        <h2 class="card-title">Cuota anual</h2>
        <div class="cf"><div class="field-label">Ejercicio</div><div class="cf-v"><%= cuota.anio %></div></div>
        <div class="cf"><div class="field-label">Importe</div><div class="cf-v"><%= fmt.euros(cuota.importe) %></div></div>
        <div class="cf"><div class="field-label">Estado</div><div class="cf-v<%= pagada ? '' : ' is-pendiente' %>"><%= fmt.ETIQ.estadoCuota[cuota.estado_visible] %></div></div>
        <div class="cuota-nota"><%= pagada ? 'Cuota al corriente' : 'Pendiente de pago · Abónala antes del 30 de marzo' %></div>
      </section>
      <section class="card cuota-card">
        <h2 class="card-title">Pago y comprobante</h2>
        <div class="cf"><div class="field-label">Fecha de pago</div><div class="cf-v"><%= pagada ? dates.corta(cuota.fecha_pago) : '—' %></div></div>
        <div class="cf"><div class="field-label">Forma de pago</div><div class="cf-v"><%= pagada ? fmt.ETIQ.formaPago[cuota.forma_pago] : '—' %></div></div>
        <% if (pagada && tarjetaPago) { %>
          <div class="cf"><div class="field-label">Tarjeta utilizada</div><div class="cf-v">•••• •••• •••• <%= tarjetaPago.ultimos %></div></div>
        <% } %>
        <% if (tarjetaGuardada) { %>
          <div class="cf"><div class="field-label">Tarjeta guardada</div><div class="cf-v">•••• •••• •••• <%= tarjetaGuardada.ultimos %></div></div>
        <% } %>
        <div class="cf"><div class="field-label">Emisión del comprobante</div><div class="cf-v"><%= cuota.fecha_emision ? dates.corta(cuota.fecha_emision) : '—' %></div></div>
        <% if (pagada && cuota.comprobante_id) { %>
          <a class="btn btn-primary cuota-ver" href="/cuota/<%= cuota.anio %>/comprobante">Ver comprobante</a>
        <% } %>
      </section>
    </div>
    <% if (!pagada) { %>
      <section class="card pagar-cuota">
        <div class="pagar-main">
          <h2>Pagar cuota</h2>
          <p>Tu cuota anual de <%= cuota.anio %> está pendiente. Págala ahora para mantener tu condición de socio. Si no se abona antes del 30 de marzo, pasará a baja y se liberará tu número de socio.</p>
        </div>
        <div class="pagar-side">
          <div class="pagar-l">Importe a pagar</div>
          <div class="pagar-v"><%= fmt.euros(cuota.importe) %></div>
          <a class="btn btn-primary pagar-btn" href="/cuota/pago?anio=<%= cuota.anio %>">Pagar cuota</a>
        </div>
        <span class="pill pill--pendiente pagar-pill">Pendiente</span>
      </section>
    <% } %>
    <% if (probar) { %>
      <form class="fecha-prueba cuota-prueba<%= pagada ? '' : ' is-pendiente' %>" method="post" action="/cuota/estado-prueba">
        <input type="hidden" name="anio" value="<%= cuota.anio %>">
        <input type="hidden" name="estado" value="<%= pagada ? 'PENDIENTE' : 'PAGADA' %>">
        <div>
          <div class="t1">Estado de la cuota: <%= pagada ? 'abonada' : 'pendiente' %></div>
          <div class="t2">Solo para probar el prototipo</div>
        </div>
        <button class="btn btn-white" type="submit"><%= pagada ? 'Ver pendiente' : 'Ver abonada' %></button>
      </form>
    <% } %>
  <% } %>
</div>
<div class="page-bottom cuota-bottom<%= cuota && cuota.estado !== 'PAGADA' ? ' is-pendiente' : '' %>"></div>
<%- include('../partials/bottom', { variant: 'socio' }) %>
