<%- include('../partials/top', { variant: 'acceso', etiqueta: 'Área de socios' }) %>
<div class="container lg-page">
  <a class="lg-volver" href="/"><span class="arrow">←</span> Volver a las salidas</a>
  <div class="lg">
    <aside class="lg-panel">
      <div class="lg-eyebrow">Club Ciclista de Brenes</div>
      <h2>Vuelve<br>al pelotón.</h2>
      <p class="lg-lead">Los mejores kilómetros<br>son los que compartimos.</p>
      <hr>
      <h3>Tu club, en un solo lugar</h3>
      <p class="lg-txt">Inscríbete en las salidas, consulta tu cuota,<br>sigue tu clasificación y pide tu equipación.</p>
      <p class="lg-lugar">Brenes · Sevilla</p>
    </aside>
    <div class="lg-form">
      <div class="lg-eyebrow2">Acceso socios</div>
      <h1>Iniciar sesión</h1>
      <p class="lg-sub">Accede con tu cuenta del club.</p>
      <div class="lg-nota">
        <div class="t1">Para inscribirte en una ruta necesitas iniciar sesión.</div>
        <div class="t2">Consultar las salidas es libre y no requiere una cuenta.</div>
      </div>
      <%- include('../partials/flash') %>
      <form method="post" action="/acceso" novalidate>
        <input type="hidden" name="next" value="<%= next %>">
        <label class="lg-label" for="email">Correo electrónico</label>
        <input class="input lg-input" id="email" name="email" type="email" autocomplete="username" placeholder="Tu correo electrónico" value="<%= valores.email || '' %>" required>
        <label class="lg-label" for="password">Contraseña</label>
        <input class="input lg-input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Introduce tu contraseña" required>
        <button class="btn btn-primary btn-block lg-entrar" type="submit">Iniciar sesión</button>
      </form>
      <a class="btn btn-secondary btn-block lg-otro" href="/registro">¿No tienes una cuenta? Regístrate</a>
      <div class="lg-ayuda">
        <div class="t1">¿Necesitas ayuda para acceder?</div>
        <div class="t2">Contacta con la directiva en la sede del club.</div>
      </div>
    </div>
  </div>
</div>
<div class="page-bottom lg-bottom"></div>
<%- include('../partials/bottom', { variant: 'acceso' }) %>
