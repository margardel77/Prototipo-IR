<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo ? titulo + ' · ' : '' %>Club Ciclista de Brenes</title>
  <meta name="description" content="Club Ciclista de Brenes: salidas, cuotas, clasificación y equipación de los socios.">
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/styles.css?v=<%= vCss %>">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 46 46'%3E%3Crect width='46' height='46' rx='10' fill='%23DEF179'/%3E%3Ctext x='23' y='30' font-family='Arial' font-weight='700' font-size='18' text-anchor='middle' fill='%2320291F'%3ECB%3C/text%3E%3C/svg%3E">
  <script src="/static/js/app.js?v=<%= v %>" defer></script>
</head>
<body>
<%
  const vt = typeof variant !== 'undefined' ? variant : 'public';
  const homeUrl = usuario ? '/salidas' : '/';
%>
<header class="topbar topbar--<%= vt %>" data-topbar>
  <div class="container">
    <a class="brand" href="<%= vt === 'gestion' ? '/gestion' : homeUrl %>">
      <span class="logo" aria-hidden="true">CB</span>
      <span class="brand-name">Club Ciclista de Brenes</span>
    </a>

    <% if (vt === 'public') { %>
      <nav class="nav" aria-label="Principal">
        <a class="is-active" href="/">Salidas</a>
      </nav>
      <span class="topbar-place"><%= config.club.localidad %></span>
      <a class="btn btn-primary topbar-cta" href="/acceso">Acceso socios</a>
    <% } else if (vt === 'acceso') { %>
      <span class="topbar-tag"><%= typeof etiqueta !== 'undefined' ? etiqueta : 'Área de socios' %></span>
    <% } else if (vt === 'socio') { %>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false">Menú</button>
      <nav class="nav" aria-label="Área de socios">
        <% [['salidas','Salidas','/salidas',116],['cuota','Mi cuota','/cuota',116],['equipacion','Equipación','/equipacion',148],['clasificacion','Clasificación','/clasificacion',160]].forEach(([k, t, u, w]) => { %>
          <a href="<%= u %>" style="width:<%= w %>px" class="<%= typeof nav !== 'undefined' && nav === k ? 'is-active' : '' %>"<%- typeof nav !== 'undefined' && nav === k ? ' aria-current="page"' : '' %>><%= t %></a>
        <% }) %>
      </nav>
      <% if (permisos.length) { %>
        <a class="btn btn-primary topbar-cta" href="/gestion">Ir a gestión</a>
      <% } %>
    <% } else if (vt === 'gestion') { %>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false">Menú</button>
      <nav class="nav" aria-label="Gestión">
        <% (typeof tabs !== 'undefined' ? tabs : []).forEach((t) => { %>
          <a href="<%= t.url %>" style="width:<%= t.ancho %>px" class="<%= typeof tab !== 'undefined' && tab === t.clave ? 'is-active' : '' %>"<%- typeof tab !== 'undefined' && tab === t.clave ? ' aria-current="page"' : '' %>><%= t.etiqueta %></a>
        <% }) %>
      </nav>
      <a class="btn btn-primary topbar-cta" href="/gestion/volver">Volver al área de socio</a>
    <% } %>
  </div>
</header>
<main>
