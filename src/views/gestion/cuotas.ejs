<%- include('../partials/top', { variant: 'gestion' }) %>
<%
  const sel = seleccionada;
  const pillCls = { PAGADA: 'is-abonada', PENDIENTE: 'is-pendiente', BAJA: 'is-baja' };
  const puedeVerFichas = permisos.includes('socios');
  const v = { estado: valores.estado || 'PAGADA', forma: valores.forma || 'EFECTIVO', fecha: valores.fecha || dates.corta(hoy) };
%>
<div class="container page cuotas-page">
  <div class="page-head">
    <h1>Cuotas de socios</h1>
    <p class="sub">Consulta las cuotas y registra los pagos por ejercicio.</p>
  </div>
  <%- include('../partials/flash') %>
  <section class="renovacion">
    <div class="ren-periodo">
      <div class="ren-eyebrow">Periodo de renovación</div>
      <div class="ren-fechas">1 ene – 30 mar</div>
    </div>
    <p class="ren-texto">Pasado el 30 de marzo, las cuotas que sigan pendientes pasan a baja y se<br>libera su número de socio.</p>
    <div class="ren-badges">
      <span class="ren-badge is-abonada"><%= inf.numPagadas %> <%= inf.numPagadas === 1 ? 'abonada' : 'abonadas' %></span>
      <span class="ren-badge is-pendiente"><%= inf.numPendientes %> <%= inf.numPendientes === 1 ? 'pendiente' : 'pendientes' %></span>
      <span class="ren-badge is-baja"><%= inf.numBajas %> <%= inf.numBajas === 1 ? 'baja' : 'bajas' %></span>
    </div>
  </section>

  <div class="cuotas-tabla">
    <table class="ct-head" aria-hidden="true">
      <colgroup><col class="k1"><col class="k2"><col class="k3"><col class="k4"><col class="k5"><col class="k6"><col class="k7"><col></colgroup>
      <thead><tr><th>N.º socio</th><th>Socio</th><th>Ejercicio</th><th>Importe</th><th>Estado</th><th>Fecha de pago</th><th>Forma de pago</th><th></th></tr></thead>
    </table>
    <div class="ct-scroll">
      <table class="ct-body">
        <caption class="sr-only">Cuotas del ejercicio <%= anio %></caption>
        <colgroup><col class="k1"><col class="k2"><col class="k3"><col class="k4"><col class="k5"><col class="k6"><col class="k7"><col></colgroup>
        <thead class="sr-only"><tr><th>N.º socio</th><th>Socio</th><th>Ejercicio</th><th>Importe</th><th>Estado</th><th>Fecha de pago</th><th>Forma de pago</th><th>Acción</th></tr></thead>
        <tbody>
          <% if (!inf.filas.length) { %><tr><td colspan="8" class="muted">No hay cuotas generadas para <%= anio %>.</td></tr><% } %>
          <% inf.filas.forEach((c) => { const esSel = sel && sel.id === c.id; %>
            <tr class="<%= esSel ? 'is-selected' : '' %>">
              <td><%= c.numero ?? '—' %></td>
              <td class="ct-socio"><% if (puedeVerFichas) { %><a href="/gestion/socios/<%= c.socio_id %>"><%= c.nombre %> <%= c.apellidos %></a><% } else { %><%= c.nombre %> <%= c.apellidos %><% } %></td>
              <td><%= c.anio %></td>
              <td><%= fmt.euros(c.importe) %></td>
              <td><span class="ct-pill <%= pillCls[c.estado_visible] %>"><%= fmt.ETIQ.estadoCuota[c.estado_visible] %></span></td>
              <td><%= c.fecha_pago ? dates.corta(c.fecha_pago) : '—' %></td>
              <td><%= c.forma_pago ? fmt.ETIQ.formaPago[c.forma_pago] : '—' %></td>
              <td>
                <% if (c.estado_visible === 'PENDIENTE') { %>
                  <a class="btn btn-primary ct-registrar" href="/gestion/cuotas?anio=<%= anio %>&cuota=<%= c.id %>#registrar">Registrar pago</a>
                <% } else if (c.estado_visible === 'BAJA') { %>
                  <span class="ct-liberado">N.º liberado</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="grid cuotas-grid stretch">
    <section class="card registrar" id="registrar">
      <h2>Registrar pago</h2>
      <div class="reg-l">Cuota seleccionada</div>
      <div class="reg-sel"><%= sel ? `${sel.nombre} ${sel.apellidos} · n.º ${sel.numero ?? '—'} · Ejercicio ${sel.anio} · ${fmt.euros(sel.importe)}` : '—' %></div>
      <form id="form-pago" method="post" action="<%= sel ? `/gestion/cuotas/${sel.id}/pago` : '#' %>" class="reg-grid" novalidate>
        <div>
          <label class="reg-l" for="estado">Estado de la cuota</label>
          <select class="reg-input reg-select" id="estado" name="estado"<%= sel ? '' : ' disabled' %>>
            <option value="PAGADA" <%= v.estado === 'PAGADA' ? 'selected' : '' %>>Abonada</option>
            <option value="PENDIENTE" <%= v.estado === 'PENDIENTE' ? 'selected' : '' %>>Pendiente</option>
          </select>
        </div>
        <div>
          <label class="reg-l" for="forma">Forma de pago</label>
          <select class="reg-input reg-select" id="forma" name="forma"<%= sel ? '' : ' disabled' %>>
            <option value="EFECTIVO" <%= v.forma === 'EFECTIVO' ? 'selected' : '' %>>Efectivo</option>
            <option value="BANCO" <%= v.forma === 'BANCO' ? 'selected' : '' %>>Banco</option>
          </select>
        </div>
        <div>
          <label class="reg-l" for="fecha">Fecha de pago</label>
          <input class="reg-input" id="fecha" name="fecha" value="<%= v.fecha %>" autocomplete="off"<%= sel ? '' : ' disabled' %>>
        </div>
        <div>
          <span class="reg-l">Emisión del comprobante</span>
          <div class="reg-input reg-auto"><%= dates.corta(hoy) %> · automática</div>
        </div>
      </form>
    </section>
    <section class="card card--soft control">
      <h2>Control de cuotas</h2>
      <p>Registra únicamente un pago que ya hayas recibido por banco<br>o en efectivo. Al guardar, la cuota pasa a Abonada y se emite el<br>comprobante.</p>
      <div class="reg-l control-l">Estado actual</div>
      <% if (sel) { %><span class="ct-pill is-pendiente control-pill">Pendiente</span><% } else { %><span class="control-vacio">—</span><% } %>
      <button class="btn btn-primary btn-block control-guardar" type="submit" form="form-pago"<%= sel ? '' : ' disabled' %>>Guardar pago</button>
    </section>
  </div>
</div>
<div class="page-bottom cuotas-bottom"></div>
<%- include('../partials/bottom', { variant: 'gestion' }) %>
